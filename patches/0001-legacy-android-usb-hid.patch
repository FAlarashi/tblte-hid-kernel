From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FAlarashi <171515457+FAlarashi@users.noreply.github.com>
Date: Thu, 10 Sep 2026 00:00:00 +0000
Subject: [PATCH] tblte: add on-demand legacy android_usb HID keyboard and mouse

Integrate the existing 3.10 HID gadget function with Samsung's legacy
android_usb composite driver. HID is registered as an available Android USB
function but is not forced into every default composition.

The implementation creates two standard boot HID interfaces:
  hidg0: keyboard, 8-byte reports
  hidg1: relative mouse, 4-byte reports

Signed-off-by: FAlarashi <171515457+FAlarashi@users.noreply.github.com>
---
 drivers/usb/gadget/Makefile                    |  2 +-
 drivers/usb/gadget/android.c                   | 39 ++++++++++++++++++++++++++
 drivers/usb/gadget/f_hid.c                     |  6 ++--
 drivers/usb/gadget/f_hid.h                     | 13 ++++++++
 drivers/usb/gadget/f_hid_android_keyboard.c   | 27 +++++++++++++++++
 drivers/usb/gadget/f_hid_android_mouse.c      | 23 ++++++++++++++
 6 files changed, 106 insertions(+), 4 deletions(-)

--- a/drivers/usb/gadget/Makefile
+++ b/drivers/usb/gadget/Makefile
@@ -64,7 +64,7 @@ g_acm_ms-y := acm_ms.o
 g_android-y := android.o
+g_android-y := android.o f_hid.o
 g_tcm_usb_gadget-y := tcm_usb_gadget.o
 
--- a/drivers/usb/gadget/android.c
+++ b/drivers/usb/gadget/android.c
@@ -50,6 +50,9 @@
 #include "f_rndis.c"
 #include "rndis.c"
 #include "u_ether.c"
+#include "f_hid.h"
+#include "f_hid_android_keyboard.c"
+#include "f_hid_android_mouse.c"
 
 MODULE_AUTHOR("Mike Lockwood");
 MODULE_DESCRIPTION("Android Composite USB Driver");
@@ -2800,6 +2803,40 @@ static struct android_usb_function uasp_function = {
 	.bind_config	= uasp_function_bind_config,
 };
 
+static int hid_function_init(struct android_usb_function *f,
+				struct usb_composite_dev *cdev)
+{
+	return ghid_setup(cdev->gadget, 2);
+}
+
+static void hid_function_cleanup(struct android_usb_function *f)
+{
+	ghid_cleanup();
+}
+
+static int hid_function_bind_config(struct android_usb_function *f,
+					struct usb_configuration *c)
+{
+	int ret;
+
+	ret = hidg_bind_config(c, &ghid_device_android_keyboard, 0);
+	if (ret) {
+		pr_err("%s: keyboard bind failed: %d\n", __func__, ret);
+		return ret;
+	}
+
+	ret = hidg_bind_config(c, &ghid_device_android_mouse, 1);
+	if (ret) {
+		pr_err("%s: mouse bind failed: %d\n", __func__, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static struct android_usb_function hid_function = {
+	.name		= "hid",
+	.init		= hid_function_init,
+	.cleanup	= hid_function_cleanup,
+	.bind_config	= hid_function_bind_config,
+};
+
 static struct android_usb_function *supported_functions[] = {
 	&ffs_function,
 	&mbim_function,
@@ -2835,6 +2872,7 @@ static struct android_usb_function *supported_functions[] = {
 #endif
 	&uasp_function,
+	&hid_function,
 	NULL
 };
 
--- a/drivers/usb/gadget/f_hid.c
+++ b/drivers/usb/gadget/f_hid.c
@@ -398,7 +398,7 @@ static int hidg_setup(struct usb_function *f,
 	case ((USB_DIR_IN | USB_TYPE_CLASS | USB_RECIP_INTERFACE) << 8
 		  | HID_REQ_GET_PROTOCOL):
 		VDBG(cdev, "get_protocol\n");
-		goto stall;
+		length = min_t(unsigned, length, 1);
+		if (hidg->bInterfaceSubClass == USB_INTERFACE_SUBCLASS_BOOT)
+			((u8 *) req->buf)[0] = 0;
+		else
+			((u8 *) req->buf)[0] = 1;
+		goto respond;
 		break;
@@ -410,7 +410,14 @@ static int hidg_setup(struct usb_function *f,
 	case ((USB_DIR_OUT | USB_TYPE_CLASS | USB_RECIP_INTERFACE) << 8
 		  | HID_REQ_SET_PROTOCOL):
 		VDBG(cdev, "set_protocol\n");
+		length = 0;
+		if (hidg->bInterfaceSubClass == USB_INTERFACE_SUBCLASS_BOOT) {
+			if (value == 0)
+				goto respond;
+		} else {
+			if (value == 1)
+				goto respond;
+		}
 		goto stall;
 		break;
@@ -559,7 +566,7 @@ static struct file_operations f_hidg_fops = {
-static int __init hidg_bind(struct usb_configuration *c, struct usb_function *f)
+static int hidg_bind(struct usb_configuration *c, struct usb_function *f)
@@ -778,7 +785,7 @@ int __init hidg_bind_config(struct usb_configuration *c,
-int __init hidg_bind_config(struct usb_configuration *c,
+int hidg_bind_config(struct usb_configuration *c,
@@ -832,7 +839,7 @@ int __init ghid_setup(struct usb_gadget *g, int count)
-int __init ghid_setup(struct usb_gadget *g, int count)
+int ghid_setup(struct usb_gadget *g, int count)
 
--- /dev/null
+++ b/drivers/usb/gadget/f_hid.h
@@ -0,0 +1,13 @@
+#ifndef _GADGET_F_HID_H
+#define _GADGET_F_HID_H
+
+#include <linux/hid.h>
+#include <linux/usb/composite.h>
+#include <linux/usb/gadget.h>
+#include <linux/usb/g_hid.h>
+
+int hidg_bind_config(struct usb_configuration *c,
+		struct hidg_func_descriptor *fdesc, int index);
+int ghid_setup(struct usb_gadget *g, int count);
+void ghid_cleanup(void);
+
+#endif
+
--- /dev/null
+++ b/drivers/usb/gadget/f_hid_android_keyboard.c
@@ -0,0 +1,27 @@
+#include <linux/usb/g_hid.h>
+
+static struct hidg_func_descriptor ghid_device_android_keyboard = {
+	.subclass = 1,
+	.protocol = 1,
+	.report_length = 8,
+	.report_desc_length = 63,
+	.report_desc = {
+		0x05, 0x01, 0x09, 0x06, 0xa1, 0x01,
+		0x05, 0x07, 0x19, 0xe0, 0x29, 0xe7,
+		0x15, 0x00, 0x25, 0x01, 0x75, 0x01,
+		0x95, 0x08, 0x81, 0x02, 0x95, 0x01,
+		0x75, 0x08, 0x81, 0x03, 0x95, 0x05,
+		0x75, 0x01, 0x05, 0x08, 0x19, 0x01,
+		0x29, 0x05, 0x91, 0x02, 0x95, 0x01,
+		0x75, 0x03, 0x91, 0x03, 0x95, 0x06,
+		0x75, 0x08, 0x15, 0x00, 0x25, 0x65,
+		0x05, 0x07, 0x19, 0x00, 0x29, 0x65,
+		0x81, 0x00, 0xc0
+	}
+};
+
--- /dev/null
+++ b/drivers/usb/gadget/f_hid_android_mouse.c
@@ -0,0 +1,23 @@
+#include <linux/usb/g_hid.h>
+
+static struct hidg_func_descriptor ghid_device_android_mouse = {
+	.subclass = 1,
+	.protocol = 2,
+	.report_length = 4,
+	.report_desc_length = 52,
+	.report_desc = {
+		0x05, 0x01, 0x09, 0x02, 0xa1, 0x01,
+		0x09, 0x01, 0xa1, 0x00, 0x05, 0x09,
+		0x19, 0x01, 0x29, 0x05, 0x15, 0x00,
+		0x25, 0x01, 0x95, 0x05, 0x75, 0x01,
+		0x81, 0x02, 0x95, 0x01, 0x75, 0x03,
+		0x81, 0x01, 0x05, 0x01, 0x09, 0x30,
+		0x09, 0x31, 0x09, 0x38, 0x15, 0x81,
+		0x25, 0x7f, 0x75, 0x08, 0x95, 0x03,
+		0x81, 0x06, 0xc0, 0xc0
+	}
+};
+
